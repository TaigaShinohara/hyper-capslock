{
  "rules": [
    {
      "description": "CapsLock: tap = Esc, hold = Hyper (Ctrl+Alt+Shift+Cmd)",
      "manipulators": [
        {
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": []
            },
            {
              "key_code": "left_control",
              "modifiers": []
            },
            {
              "key_code": "left_option",
              "modifiers": []
            },
            {
              "key_code": "left_command",
              "modifiers": []
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
